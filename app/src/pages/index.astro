---
import BaseLayout from '../layouts/BaseLayout.astro';
import fs from 'node:fs';
import path from 'node:path';

// Load stats during static site generation
let stats = {
  sources: { "JAV.guru": 28003, "MissAV": 30443, "OneJAV": 4708, "JavCT": 941, "Models": 1525 },
  timeline: {},
  total_codes: 36654
};

try {
  const statsPath = path.resolve('public/stats.json');
  if (fs.existsSync(statsPath)) {
    stats = JSON.parse(fs.readFileSync(statsPath, 'utf-8'));
  }
} catch (e) {
  // fallback values
}

const totalItems = Object.values(stats.sources).reduce((a, b) => a + b, 0);
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout currentPage="overview" activeSource="Overview & Signals" itemCount={`${totalItems.toLocaleString()} total`}>
  <div class="space-y-8">

    <!-- Hero / Archive Overview Title -->
    <div class="border-b border-[var(--border-rule)] pb-6 flex flex-col md:flex-row md:items-end justify-between gap-4">
      <div>
        <div class="flex items-center gap-2 text-xs font-mono text-[var(--accent-cyan)] mb-2">
          <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent-cyan)]"></span>
          CATALOGUE DISPATCH · MULTI-SOURCE INGESTION
        </div>
        <h1 class="font-display text-2xl sm:text-3xl font-bold tracking-tight text-[var(--text-bright)]">
          Repository Overview & Telemetry
        </h1>
        <p class="text-sm text-[var(--text-dim)] font-mono mt-1 max-w-2xl">
          Consolidated metadata registry cross-referencing JAV.guru accessions, MissAV HLS playlists, OneJAV torrents, and JavCT releases.
        </p>
      </div>

      <!-- Quick Action Buttons -->
      <div class="flex items-center gap-2 font-mono text-xs">
        <a href={`${base}browse.html`} class="px-3.5 py-2 bg-[var(--accent-cyan)] hover:bg-[var(--accent-cyan-hover)] text-black font-semibold rounded no-underline transition-colors flex items-center gap-1.5">
          <span>Open Catalogue</span>
          <span>→</span>
        </a>
        <a href={`${base}sitemap.html`} class="px-3 py-2 bg-[var(--bg-panel)] hover:bg-[var(--bg-panel-hover)] border border-[var(--border-rule)] text-[var(--text-bright)] rounded no-underline transition-colors">
          Raw Data Exports
        </a>
      </div>
    </div>

    <!-- Repository KPIs / Telemetry Cards -->
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3 font-mono">
      <div class="bg-[var(--bg-panel)] border border-[var(--border-rule)] p-4 rounded-lg">
        <div class="text-[11px] text-[var(--text-muted)] mb-1">JAV.GURU</div>
        <div class="text-xl sm:text-2xl font-bold text-[var(--text-bright)] tabular-nums">
          {(stats.sources["JAV.guru"] || 28003).toLocaleString()}
        </div>
        <div class="text-[10px] text-[var(--accent-cyan)] mt-1">Master Records</div>
      </div>

      <div class="bg-[var(--bg-panel)] border border-[var(--border-rule)] p-4 rounded-lg">
        <div class="text-[11px] text-[var(--text-muted)] mb-1">MISSAV HLS</div>
        <div class="text-xl sm:text-2xl font-bold text-[var(--text-bright)] tabular-nums">
          {(stats.sources["MissAV"] || 30443).toLocaleString()}
        </div>
        <div class="text-[10px] text-[var(--accent-green)] mt-1">Direct Playlists</div>
      </div>

      <div class="bg-[var(--bg-panel)] border border-[var(--border-rule)] p-4 rounded-lg">
        <div class="text-[11px] text-[var(--text-muted)] mb-1">ONEJAV</div>
        <div class="text-xl sm:text-2xl font-bold text-[var(--text-bright)] tabular-nums">
          {(stats.sources["OneJAV"] || 4708).toLocaleString()}
        </div>
        <div class="text-[10px] text-[var(--text-dim)] mt-1">Verified Torrents</div>
      </div>

      <div class="bg-[var(--bg-panel)] border border-[var(--border-rule)] p-4 rounded-lg">
        <div class="text-[11px] text-[var(--text-muted)] mb-1">JAVCT</div>
        <div class="text-xl sm:text-2xl font-bold text-[var(--text-bright)] tabular-nums">
          {(stats.sources["JavCT"] || 941).toLocaleString()}
        </div>
        <div class="text-[10px] text-[var(--text-dim)] mt-1">Uncensored / Amateur</div>
      </div>

      <div class="bg-[var(--bg-panel)] border border-[var(--border-rule)] p-4 rounded-lg">
        <div class="text-[11px] text-[var(--text-muted)] mb-1">MODELS</div>
        <div class="text-xl sm:text-2xl font-bold text-[var(--text-bright)] tabular-nums">
          {(stats.sources["Models"] || 1525).toLocaleString()}
        </div>
        <div class="text-[10px] text-[var(--accent-cyan)] mt-1">Actresses Directory</div>
      </div>

      <div class="bg-[var(--bg-panel)] border border-[var(--border-rule)] p-4 rounded-lg">
        <div class="text-[11px] text-[var(--text-muted)] mb-1">CODE ACCESSIONS</div>
        <div class="text-xl sm:text-2xl font-bold text-[var(--accent-amber)] tabular-nums">
          {(stats.total_codes || 36654).toLocaleString()}
        </div>
        <div class="text-[10px] text-[var(--text-muted)] mt-1">Unique Index Codes</div>
      </div>
    </div>

    <!-- Source Routing Grid -->
    <div class="space-y-3">
      <div class="text-xs font-mono text-[var(--text-muted)] uppercase tracking-wider flex items-center justify-between">
        <span>Channel Indexes & Discovery</span>
        <span>SELECT SOURCE TO BROWSE</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- JAV.guru Card -->
        <a href={`${base}browse.html?source=jav.guru`} class="group bg-[var(--bg-panel)] hover:bg-[var(--bg-panel-hover)] border border-[var(--border-rule)] hover:border-[var(--accent-cyan)] p-5 rounded-lg text-inherit no-underline transition-all flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between font-mono text-xs text-[var(--text-dim)] mb-2">
              <span class="text-[var(--accent-cyan)] font-bold">SOURCE // 01</span>
              <span>28,000+ items</span>
            </div>
            <h3 class="font-display font-bold text-lg text-[var(--text-bright)] group-hover:text-[var(--text-cyan)] transition-colors">
              JAV.guru Ingestion
            </h3>
            <p class="text-xs text-[var(--text-dim)] mt-2 line-clamp-2">
              Primary media catalogue with cover art thumbnails, release dates, and matched HLS streams.
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-[var(--border-rule)] flex items-center justify-between font-mono text-[11px] text-[var(--text-dim)]">
            <span>Filter by Guru Tag</span>
            <span class="group-hover:translate-x-1 transition-transform text-[var(--accent-cyan)]">Open ↗</span>
          </div>
        </a>

        <!-- MissAV Card -->
        <a href={`${base}browse.html?source=missav`} class="group bg-[var(--bg-panel)] hover:bg-[var(--bg-panel-hover)] border border-[var(--border-rule)] hover:border-[var(--accent-green)] p-5 rounded-lg text-inherit no-underline transition-all flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between font-mono text-xs text-[var(--text-dim)] mb-2">
              <span class="text-[var(--accent-green)] font-bold">SOURCE // 02</span>
              <span>30,000+ items</span>
            </div>
            <h3 class="font-display font-bold text-lg text-[var(--text-bright)] group-hover:text-[var(--accent-green)] transition-colors">
              MissAV Stream Index
            </h3>
            <p class="text-xs text-[var(--text-dim)] mt-2 line-clamp-2">
              Decoded M3U8 multi-bitrate streams (1080p, 720p, 480p) ready for instant in-browser playback.
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-[var(--border-rule)] flex items-center justify-between font-mono text-[11px] text-[var(--text-dim)]">
            <span>Direct HLS Player</span>
            <span class="group-hover:translate-x-1 transition-transform text-[var(--accent-green)]">Open ↗</span>
          </div>
        </a>

        <!-- OneJAV Card -->
        <a href={`${base}browse.html?source=onejav`} class="group bg-[var(--bg-panel)] hover:bg-[var(--bg-panel-hover)] border border-[var(--border-rule)] hover:border-[var(--accent-amber)] p-5 rounded-lg text-inherit no-underline transition-all flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between font-mono text-xs text-[var(--text-dim)] mb-2">
              <span class="text-[var(--accent-amber)] font-bold">SOURCE // 03</span>
              <span>4,700+ items</span>
            </div>
            <h3 class="font-display font-bold text-lg text-[var(--text-bright)] group-hover:text-[var(--accent-amber)] transition-colors">
              OneJAV Torrents
            </h3>
            <p class="text-xs text-[var(--text-dim)] mt-2 line-clamp-2">
              Rolling 20-day torrent tracker index with exact file sizes, actresses, and magnet links.
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-[var(--border-rule)] flex items-center justify-between font-mono text-[11px] text-[var(--text-dim)]">
            <span>Direct .torrent Files</span>
            <span class="group-hover:translate-x-1 transition-transform text-[var(--accent-amber)]">Open ↗</span>
          </div>
        </a>

        <!-- JavCT Card -->
        <a href={`${base}browse.html?source=javct`} class="group bg-[var(--bg-panel)] hover:bg-[var(--bg-panel-hover)] border border-[var(--border-rule)] hover:border-purple-400 p-5 rounded-lg text-inherit no-underline transition-all flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between font-mono text-xs text-[var(--text-dim)] mb-2">
              <span class="text-purple-400 font-bold">SOURCE // 04</span>
              <span>900+ items</span>
            </div>
            <h3 class="font-display font-bold text-lg text-[var(--text-bright)] group-hover:text-purple-400 transition-colors">
              JavCT Uncensored
            </h3>
            <p class="text-xs text-[var(--text-dim)] mt-2 line-clamp-2">
              Amateur, uncensored, and category-indexed video links with view counter verification.
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-[var(--border-rule)] flex items-center justify-between font-mono text-[11px] text-[var(--text-dim)]">
            <span>Source Page Outlinks</span>
            <span class="group-hover:translate-x-1 transition-transform text-purple-400">Open ↗</span>
          </div>
        </a>
      </div>
    </div>

    <!-- Pipeline Architecture & Freshness Notes -->
    <div class="bg-[var(--bg-panel)] border border-[var(--border-rule)] p-5 rounded-lg font-mono text-xs space-y-3">
      <div class="flex items-center justify-between border-b border-[var(--border-rule)] pb-2">
        <span class="text-[var(--text-bright)] font-bold uppercase tracking-wider">Automated Ingestion Pipeline Spec</span>
        <span class="text-[var(--accent-green)]">STATUS: HEALTHY</span>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-[var(--text-dim)]">
        <div>
          <span class="text-[var(--text-bright)] block mb-1">Cloudflare Clearance</span>
          <span>Async headless crawl4ai bootstrap passes CF once, generating reusable session cookies for fast aiohttp streaming.</span>
        </div>
        <div>
          <span class="text-[var(--text-bright)] block mb-1">M3U8 Stream Extraction</span>
          <span>Dean Edwards packed JS unpacker extracts direct HLS endpoints with zero browser runtime overhead.</span>
        </div>
        <div>
          <span class="text-[var(--text-bright)] block mb-1">Deterministic Deduplication</span>
          <span>Normalized video codes and filename timestamps ensure lossless incremental updates across GitHub Actions daily cron.</span>
        </div>
      </div>
    </div>

  </div>
</BaseLayout>
